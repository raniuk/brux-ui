{
  "name": "@brux-ui/react",
  "version": "0.1.0",
  "description": "Brux UI React design system: tokens, themes, and accessible components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raniuk/brux-ui.git"
  },
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist storybook-static",
    "storybook": "storybook dev -p 6006 -c docs/.storybook",
    "build:storybook": "storybook build -c docs/.storybook -o storybook-static",
    "prepare": "npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.58.0",
    "radix-ui": "^1.8.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  }
}
